{
  "__inputs": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "Rate Limit Engine",
  "uid": "ratelimit-engine",
  "tags": [
    "ratelimit"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Decision rate by rule",
      "datasource": {
        "type": "prometheus",
        "uid": "ratelimit-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ratelimit-prometheus"
          },
          "expr": "sum by (rule) (rate(ratelimit_decisions_total{mode=\"check\",decision=\"allowed\"}[1m]))",
          "legendFormat": "{{rule}} allowed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ratelimit-prometheus"
          },
          "expr": "sum by (rule) (rate(ratelimit_decisions_total{mode=\"check\",decision=\"denied\"}[1m]))",
          "legendFormat": "{{rule}} denied",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Deny ratio by algorithm",
      "datasource": {
        "type": "prometheus",
