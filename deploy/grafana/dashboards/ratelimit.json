        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ratelimit-prometheus"
          },
          "expr": "sum by (algorithm) (rate(ratelimit_decisions_total{mode=\"check\",decision=\"denied\"}[1m]))\n/ clamp_min(sum by (algorithm) (rate(ratelimit_decisions_total{mode=\"check\"}[1m])), 0.001)",
          "legendFormat": "{{algorithm}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {}
        },
        "overrides": []
      },
